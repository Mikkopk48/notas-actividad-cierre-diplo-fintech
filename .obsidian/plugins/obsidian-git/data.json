{
  "commitMessage": "vault: {{date}}",
  "autoCommitMessage": "auto: {{date}} ({{numFiles}} archivos)",
  "commitDateFormat": "YYYY-MM-DD HH:mm:ss",
  "autoSaveInterval": 5,
  "autoPushInterval": 0,
  "autoPullInterval": 10,
  "autoPullOnBoot": true,
  "differentIntervalCommitAndPush": false,
  "autoBackupAfterFileChange": false,
  "pullBeforePush": true,
  "disablePush": false,
  "syncMethod": "merge",
  "showStatusBar": true
}
